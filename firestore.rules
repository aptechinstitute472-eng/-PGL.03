rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDateString(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidWorkspaceState(data, userId) {
      return data.keys().hasAll([
          'uid',
          'selectedTrackId',
          'languageMode',
          'uiLanguage',
          'completedChecklistIds',
          'completedWeeklyTaskIds',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'selectedTrackId',
          'languageMode',
          'uiLanguage',
          'completedChecklistIds',
          'completedWeeklyTaskIds',
          'updatedAt'
        ])
        && data.uid == userId
        && data.selectedTrackId is string
        && data.selectedTrackId.size() >= 1
        && data.selectedTrackId.size() <= 40
        && data.selectedTrackId.matches('^[a-z0-9\\-]+$')
        && data.languageMode in ['english', 'roman_urdu', 'bilingual']
        && data.uiLanguage in ['en', 'roman_urdu']
        && data.completedChecklistIds is list
        && data.completedChecklistIds.size() <= 250
        && (data.completedChecklistIds.size() == 0 || data.completedChecklistIds[0] is string)
        && data.completedWeeklyTaskIds is list
        && data.completedWeeklyTaskIds.size() <= 250
        && (data.completedWeeklyTaskIds.size() == 0 || data.completedWeeklyTaskIds[0] is string)
        && data.updatedAt is timestamp;
    }

    function isValidLedgerEntry(data, userId) {
      return data.keys().hasAll([
          'uid',
          'trackId',
          'cadence',
          'weekIndex',
          'date',
          'taskTitle',
          'source',
          'amountUsd',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'trackId',
          'cadence',
          'weekIndex',
          'date',
          'taskTitle',
          'source',
          'amountUsd',
          'createdAt'
        ])
        && data.uid == userId
        && data.trackId is string
        && data.trackId.size() >= 1
        && data.trackId.size() <= 40
        && data.cadence in ['daily', 'weekly']
        && data.weekIndex is int
        && data.weekIndex >= 0
        && data.weekIndex <= 3
        && isValidDateString(data.date)
        && data.taskTitle is string
        && data.taskTitle.size() >= 1
        && data.taskTitle.size() <= 200
        && data.source is string
        && data.source.size() >= 1
        && data.source.size() <= 120
        && data.amountUsd is number
        && data.amountUsd > 0
        && data.amountUsd <= 1000000
        && data.createdAt is timestamp;
    }

    function isValidWithdrawal(data, userId) {
      return data.keys().hasAll([
          'uid',
          'method',
          'platformSource',
          'grossUsd',
          'feeUsd',
          'fxRate',
          'netPkr',
          'status',
          'date',
          'referenceNote',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'method',
          'platformSource',
          'grossUsd',
          'feeUsd',
          'fxRate',
          'netPkr',
          'status',
          'date',
          'referenceNote',
          'createdAt'
        ])
        && data.uid == userId
        && data.method in [
          'Payoneer',
          'Wise',
          'Local Bank (IBFT)',
          'JazzCash / Easypaisa',
          'Upwork / Fiverr Direct'
        ]
        && data.platformSource is string
        && data.platformSource.size() >= 1
        && data.platformSource.size() <= 120
        && data.grossUsd is number
        && data.grossUsd > 0
        && data.grossUsd <= 1000000
        && data.feeUsd is number
        && data.feeUsd >= 0
        && data.feeUsd <= data.grossUsd
        && data.fxRate is number
        && data.fxRate > 0
        && data.fxRate <= 2000
        && data.netPkr is number
        && data.netPkr >= 0
        && data.status in ['Pending', 'Cleared']
        && isValidDateString(data.date)
        && data.referenceNote is string
        && data.referenceNote.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidJournalEntry(data, userId) {
      return data.keys().hasAll([
          'uid',
          'trackId',
          'date',
          'reflection',
          'tags',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'trackId',
          'date',
          'reflection',
          'tags',
          'createdAt'
        ])
        && data.uid == userId
        && data.trackId is string
        && data.trackId.size() >= 1
        && data.trackId.size() <= 40
        && isValidDateString(data.date)
        && data.reflection is string
        && data.reflection.size() >= 1
        && data.reflection.size() <= 1000
        && data.tags is list
        && data.tags.size() <= 8
        && (data.tags.size() == 0 || data.tags[0] is string)
        && data.createdAt is timestamp;
    }

    function isValidEnrollment(data, userId) {
      return data.keys().hasAll([
          'uid',
          'planId',
          'planName',
          'priceUsd',
          'pricePkr',
          'buyerName',
          'buyerContact',
          'preferredTrack',
          'paymentMethod',
          'ticketCode',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'planId',
          'planName',
          'priceUsd',
          'pricePkr',
          'buyerName',
          'buyerContact',
          'preferredTrack',
          'paymentMethod',
          'ticketCode',
          'status',
          'createdAt'
        ])
        && data.uid == userId
        && data.planId in ['starter', 'pro', 'agency']
        && data.planName is string
        && data.planName.size() >= 1
        && data.planName.size() <= 80
        && data.priceUsd is string
        && data.priceUsd.size() >= 1
        && data.priceUsd.size() <= 24
        && data.pricePkr is string
        && data.pricePkr.size() >= 1
        && data.pricePkr.size() <= 32
        && data.buyerName is string
        && data.buyerName.size() >= 1
        && data.buyerName.size() <= 120
        && data.buyerContact is string
        && data.buyerContact.size() >= 1
        && data.buyerContact.size() <= 120
        && data.preferredTrack is string
        && data.preferredTrack.size() >= 1
        && data.preferredTrack.size() <= 120
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 80
        && data.ticketCode is string
        && data.ticketCode.size() >= 4
        && data.ticketCode.size() <= 40
        && data.status in ['Submitted', 'Confirmed']
        && data.createdAt is timestamp;
    }

    match /users/{userId}/workspace/state {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidWorkspaceState(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId)
        && isValidWorkspaceState(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'selectedTrackId',
          'languageMode',
          'uiLanguage',
          'completedChecklistIds',
          'completedWeeklyTaskIds',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /users/{userId}/ledgerEntries/{entryId} {
      allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(entryId) && isOwner(userId)
        && isValidLedgerEntry(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
    }

    match /users/{userId}/withdrawals/{withdrawalId} {
      allow get: if isValidId(userId) && isValidId(withdrawalId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(withdrawalId) && isOwner(userId)
        && isValidWithdrawal(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isValidId(withdrawalId) && isOwner(userId)
        && isValidWithdrawal(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && existing().status != 'Cleared'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(userId) && isValidId(withdrawalId) && isOwner(userId);
    }

    match /users/{userId}/journalEntries/{journalId} {
      allow get: if isValidId(userId) && isValidId(journalId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(journalId) && isOwner(userId)
        && isValidJournalEntry(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isValidId(journalId) && isOwner(userId);
    }

    match /users/{userId}/enrollments/{enrollmentId} {
      allow get: if isValidId(userId) && isValidId(enrollmentId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(enrollmentId) && isOwner(userId)
        && isValidEnrollment(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
